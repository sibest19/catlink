{
  "version": "0.2.0",
  "configurations": [
    {
      // Requires the dev stack to be running: docker compose up -d
      "name": "Attach to Home Assistant (Docker)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/custom_components/catlink",
          "remoteRoot": "/config/custom_components/catlink"
        }
      ],
      // Home Assistant core frames are outside the workspace; keep them
      // steppable so breakpoints in the coordinator/entity plumbing work.
      "justMyCode": false
    }
  ]
}
